# Phase 2: use a separate non-production Dolibarr 24 staging instance.
MCP_ENV=development
DOLIBARR_URL=https://staging-dolibarr.example.invalid/api/index.php
DOLIBARR_API_KEY=
MCP_AUDIT_FILE=/absolute/path/to/private/audit.jsonl

# Local stdio: the operating-system process is trusted to assert this identity.
MCP_STDIO_SUBJECT=
MCP_STDIO_SCOPES=

# HTTP: bind to 127.0.0.1; put a trusted HTTPS reverse proxy in front later.
PORT=3000
MCP_PUBLIC_URL=https://mcp.example.invalid/mcp
MCP_OAUTH_ISSUER=https://identity.example.invalid/
MCP_OAUTH_JWKS_URI=https://identity.example.invalid/jwks
MCP_OAUTH_AUDIENCE=https://mcp.example.invalid/mcp
# Comma-separated HTTPS browser origins; blank means no cross-origin browser access.
MCP_ALLOWED_ORIGINS=
# Additional exact Host headers only if needed for local testing.
MCP_ALLOWED_HOSTS=
